@{
    ViewData["Title"] = "Välkommen";
    ViewData["Description"] = "Välkommen till Spaghetti Benedetti – där smakerna talar för sig själva. Boka bord eller kolla vår meny.";
    ViewData["Keywords"] = "spaghetti, benedetti, boka bord, restaurang, svensk mat, middag, lunch";
}

<div class="container mt-4">
    <section class="restaurant-overview text-center mb-5">
        <h1 class="display-4">Welcome to Spaghetti Benedetti</h1>
        <p class="lead">A selection of all the food in the world – straight from Nonna’s cookbook.</p>

        <div class="mt-4">
            <a href="@Url.Action("Index", "Menus")" class="btn btn-primary mr-2">View Our Menu</a>
            <a href="@Url.Action("Create", "Customer")" class="btn btn-outline-secondary">Make a Reservation</a>
        </div>
    </section>

    <section class="popular-dishes">
        <h2 class="text-center mb-4">Popular Dishes</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <img src="/images/pasta.jpg" class="card-img-top" alt="Pasta"
                         loading="lazy" width="600" height="400">
                    <div class="card-body">
                        <h5 class="card-title">Pasta Carbonara</h5>
                        <p class="card-text">Creamy. Smoky. Ridiculously delicious.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <img src="/images/pizza.jpg" class="card-img-top" alt="Pizza">
                    <div class="card-body">
                        <h5 class="card-title">Neapolitan Pizza</h5>
                        <p class="card-text">Straight from the wood-fired oven – crispy, cheesy love.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <img src="/images/tiramisu.jpg" class="card-img-top" alt="Tiramisu">
                    <div class="card-body">
                        <h5 class="card-title">Tiramisu</h5>
                        <p class="card-text">Layers of creamy coffee heaven.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
