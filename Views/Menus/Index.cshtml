@model IEnumerable<RestaurangFrontend.Models.Menu>

@{
    ViewData["Title"] = "Meny";
    ViewData["Description"] = "Kolla in vår fantastiska meny med rätter från hela världen – pasta, kött, vegetariskt och mer!";
    ViewData["Keywords"] = "restaurang meny, mat, förrätter, varmrätter, efterrätter, vegetarisk, pasta, kött";
}
<div class="container mt-5">
    <h2 class="mb-4">Our Full Menu</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row">
        @foreach (var dish in Model)
        {
            <div class="col-md-4">
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@dish.DishName</h5>
                        <p class="card-text">@dish.Description</p>
                        <p><strong>@dish.DishPrice.ToString("C")</strong></p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
