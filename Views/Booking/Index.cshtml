@model List<RestaurangFrontend.Models.Booking>

<div class="container mt-5">
    <h2>Alla Bokningar</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Customer ID</th>
                    <th>Table ID</th>
                    <th>Table Amount</th>
                    <th>Time to Arrive</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BookingId</td>
                        <td>@b.CustomerId</td>
                        <td>@b.TableId</td>
                        <td>@b.TableAmount</td>
                        <td>@b.TimeToArrive.ToString("g")</td>
                        <td>
                            <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = b.BookingId })">Edit</a>
                            <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = b.BookingId })">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
